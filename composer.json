{
    "name": "tetrode/throwpedia",
    "bin": ["bin/throwpedia"],
    "description": "Throwpedia: the business exception library",
    "type": "project",
    "require": {
        "php": "^8.5",
        "nikic/php-parser": "^5.0",
        "nette/neon": "^3.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "friendsofphp/php-cs-fixer": "^v3",
        "phpstan/phpstan": "^2",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "maglnet/composer-require-checker": "^4.21",
        "rector/rector": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "Tetrode\\Throwpedia\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tetrode\\Throwpedia\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs": "php-cs-fixer fix",
        "stan": "phpstan",
        "lint": "parallel-lint src tests --colors",
        "req": "composer-require-checker",
        "all": "composer lint && composer test && composer cs && composer stan && composer req && composer audit"
    }
}