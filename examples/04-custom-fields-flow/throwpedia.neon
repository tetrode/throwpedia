# Configuration for Flow 04 (Custom Fields)
source:
    - examples/04-custom-fields-flow/src

attributes:
    CustomReason:
        code: Error Code
        severity: Impact Level
        ticket: Tracker ID
    AnotherReason:
        code: Quick Code
        note: Simple Note
    AuditReason:
        code: Audit Code
        action: Audit Action

outputs:
    - examples/04-custom-fields-flow/output/exceptions.md
    - examples/04-custom-fields-flow/output/exceptions.json

allowDirectNew: false

# Suppress duplicate code warnings (optional)
suppressDuplicateCodeWarning: true
