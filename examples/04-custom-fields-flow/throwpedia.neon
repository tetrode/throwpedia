# Configuration for Flow 04 (Custom Fields)
source:
    - examples/04-custom-fields-flow/src

attributes:
    CustomReason:
        identifier: Error Code
        severity: Impact Level
        ticket: Tracker ID
    AnotherReason:
        identifier: Quick Code
        note: Simple Note
    AuditReason:
        identifier: Audit Code
        action: Audit Action

outputs:
    - examples/04-custom-fields-flow/output/exceptions.md
    - examples/04-custom-fields-flow/output/exceptions.json

allowDirectNew: false

# Suppress duplicate identifier warnings (optional)
suppressDuplicateIdentifierWarning: true
