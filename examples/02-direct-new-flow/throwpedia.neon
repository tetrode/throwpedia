# Configuration for Flow 02
source:
    - examples/02-direct-new-flow/src

attributes:
    - ExceptionReason

fields:
    code: Code
    technicalReason: Technical Reason
    businessReason: Business Reason

outputs:
    - examples/02-direct-new-flow/output/exceptions.yaml

allowDirectNew: true

# Suppress duplicate code warnings (optional)
suppressDuplicateCodeWarning: false
